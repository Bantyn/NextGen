        "responseBody": "={\n  \"id\": \"ai-agent-output\",\n  \"object\": \"chat.completion\",\n  \"created\": {{ Math.floor(Date.now() / 1000) }},\n  \"model\": \"openai/gpt-oss-120b\",\n  \"choices\": [\n    {\n      \"index\": 0,\n      \"message\": {\n        \"role\": \"assistant\",\n        \"content\": \"{{ ($json.output || $json.text || '').replace(/\\n/g, ' ').replace(/\"/g, '\\\\\"').trim() }}\",\n        \"reasoning\": \"\"\n      },\n      \"finish_reason\": \"stop\"\n    }\n  ],\n  \"clinical_metadata\": {\n    \"session_id\": \"{{ $('Prepare Agent Input').item.json.session_id }}\",\n    \"patient_id\": \"{{ $('Prepare Agent Input').item.json.patient_id }}\",\n    \"agent_type\": \"LangChain_Tools_Agent\"\n  }\n}"
      },
