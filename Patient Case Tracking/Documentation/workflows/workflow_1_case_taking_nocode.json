            {
              "name": "patient_id",
              "value": "={{ $json.body.patient_id || 'demo-patient-001' }}"
            },
            {
              "name": "language",
              "value": "={{ $json.body.language || 'Gujarati' }}"
            },
            {
              "name": "patient_answer",
              "value": "={{ ($json.body.patient_answer || $json.body.message || '').trim() }}"
