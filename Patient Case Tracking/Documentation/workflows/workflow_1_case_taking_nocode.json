          "boolean": [
            {
              "value1": "={{ Boolean($json.body && ($json.body.patient_answer || $json.body.message) && $json.body.session_id) }}",
              "value2": true
            }
          ]
        }
      },
      "id": "bd0a0306-0795-4a9a-8bc5-9b8bd4b339f6",
      "name": "Validate Input",
