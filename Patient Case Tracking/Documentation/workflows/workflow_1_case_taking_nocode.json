      "typeVersion": 1,
      "position": [
        976,
        2720
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Patient statement: {{ $json.patient_answer }}\nPreferred Language: {{ $json.language }}\nSession ID: {{ $json.session_id }}",
        "options": {
          "systemMessage": "=You are an intelligent, empathetic Senior Physician (MediKiosk) conducting a real-time clinical pre-consultation in {{ $('Prepare Agent Input').item.json.language }}.\n\nCLINICAL THINKING & COMMUNICATION RULES:\n1. NEVER use generic repetitive greetings, canned templates, or formulaic scripts.\n2. Deeply listen to the patient's EXACT answer and acknowledge it specifically in your response (e.g. if they say '10 days of fever', react naturally to that duration).\n3. Use your medical reasoning to ask the SINGLE most critical, natural follow-up question following the clinical history framework (SOCRATES for pain, duration/chills for fever, dry/wet for cough, meal relation for stomach pain).\n4. When appropriate for mild symptoms, suggest one personalized, natural home care or AYUSH tip without sounding like a robot.\n5. If RED FLAG / EMERGENCY (severe crushing chest pain radiating to arm, acute breathlessness, coughing blood, black stools), immediately advise resting and direct them to the urgent triage doctor.\n6. Keep your spoken reply concise (25-35 words), natural, deeply human, and strictly in {{ $('Prepare Agent Input').item.json.language }} script."
        }
      },
      "id": "4c3e68e0-ffa5-47d1-b1c8-f7f38104e4a9",
      "name": "MediKiosk Clinical AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        1232,
        2720
      ]
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {
          "maxTokensToSample": 800,
          "temperature": 0.3
        }
      },
      "id": "270e2b83-9107-40c6-86b6-3a7b72631feb",
      "name": "Groq Chat Model",
