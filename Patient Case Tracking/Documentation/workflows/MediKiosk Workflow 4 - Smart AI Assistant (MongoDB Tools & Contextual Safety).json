{
  "name": "MediKiosk Workflow 4 - Smart AI Assistant (MongoDB Tools & Contextual Safety)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "medikiosk-smart-assistant",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1b22b2f0-4955-4ffb-9b62-aadf7edce58d",
      "name": "Receive Smart Assistant Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "webhookId": "medikiosk-smart-assistant-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ Boolean($json.body && ($json.body.message || $json.body.query)) }}",
              "value2": true
            }
          ]
        }
      },
      "id": "786186c2-63c5-44c0-9c02-0bccf6a0a277",
      "name": "Validate Assistant Input",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "options": {
          "responseCode": 400
        }
      },
      "id": "4ad4aae2-4e99-4785-bc6d-101e4d8643a9",
      "name": "Return Bad Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        224,
        224
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "user_message",
              "value": "={{ ($json.body.message || $json.body.query || '').trim() }}"
            },
            {
              "name": "language",
              "value": "={{ $json.body.language || 'English' }}"
            },
            {
              "name": "user_id",
              "value": "={{ $json.body.user_context?.user_id || $json.body.user_id || 'guest' }}"
            },
            {
              "name": "role",
              "value": "={{ $json.body.user_context?.role || $json.body.role || 'PATIENT' }}"
            },
            {
              "name": "session_id",
              "value": "={{ $json.body.user_context?.session_id || $json.body.session_id || 'assistant-session' }}"
            },
            {
              "name": "injected_tool_data",
              "value": "={{ JSON.stringify($json.body.tool_data || {}) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "ce86ad41-0e71-4b1a-9cad-1500760da307",
      "name": "Normalize Context & Safe Auth",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=User Question: {{ $json.user_message }}\nLanguage: {{ $json.language }}\nUser Role: {{ $json.role }}\nVerified Database Tool Data: {{ $json.injected_tool_data }}",
        "options": {
          "systemMessage": "=You are the Smart AI Assistant for MediKiosk (Team NextGen) conducting an intelligent, empathetic conversation in {{ $('Normalize Context & Safe Auth').item.json.language }}.\n\nCLINICAL & SAFETY MANDATES:\n1. ABSOLUTE MEDICAL SAFETY: You are an informational assistant, NOT a doctor. NEVER diagnose diseases (do NOT say 'You have X condition'). NEVER prescribe drug dosages independently.\n2. NO HALLUCINATION: Answer medicine questions ONLY using the verified MongoDB records provided. If no record is found, state: 'I do not have verified information for that in the current knowledge base. Please consult a qualified physician or pharmacist.'\n3. CONTEXTUAL EMERGENCY ESCALATION: If the user describes an acute emergency (crushing chest pain with breathlessness/sweating, sudden stroke signs, severe hemorrhage), advise immediate emergency care (108 / 102) and do not give routine home advice.\n4. WEBSITE & FEATURE HELP: Explain MediKiosk features (Kiosk Voice Intake, Document OCR, Live Queue Tracking, Doctor Portal) clearly based on role.\n5. CONCISE & SPOKEN-FRIENDLY: Keep responses warm, helpful, structured, and concise (40-60 words), strictly in {{ $('Normalize Context & Safe Auth').item.json.language }} script."
        }
      },
      "id": "6d007325-37ca-4aa4-8cd6-e9f6f29ec4b4",
      "name": "Smart Assistant AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        688,
        0
      ]
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-120b",
