# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# Database Configuration
MONGO_URI=mongodb://localhost:27017/medikiosk_patient_tracking

# JWT Authentication Secrets & Expiry
JWT_SECRET=super_secret_jwt_key_medikiosk_2026_change_in_production
JWT_EXPIRES_IN=7d

# File Upload Configuration
MAX_FILE_SIZE_BYTES=10485760
UPLOAD_DIR=uploads/

# External AI Service / n8n Workflow Integration
N8N_WORKFLOW_URL=http://localhost:5678/webhook/ai-case-taking
OLLAMA_API_BASE=http://localhost:11434

# ==============================================================================
# API ENDPOINT DEFINITIONS & SPECIFICATIONS
# ==============================================================================
# Base API Prefix: /api/v1

# ------------------------------------------------------------------------------
# 1. AUTHENTICATION & STAFF MANAGEMENT APIs (/api/v1/auth & /api/v1/users)
# ------------------------------------------------------------------------------
# POST /api/v1/auth/login               - Staff/Doctor/Admin Login (Email & Password)
# POST /api/v1/auth/register            - Register new healthcare staff account
# GET  /api/v1/auth/me                  - Retrieve currently logged-in user profile
# GET  /api/v1/users                    - List all system users/staff (Admin scope)
# PUT  /api/v1/users/:id/role           - Update user role (ADMIN, DOCTOR, STAFF)

API_AUTH_LOGIN=/api/v1/auth/login
API_AUTH_REGISTER=/api/v1/auth/register
API_AUTH_ME=/api/v1/auth/me
API_USERS_LIST=/api/v1/users
API_USERS_UPDATE_ROLE=/api/v1/users/:id/role

# ------------------------------------------------------------------------------
# 2. PATIENT IDENTITY & PROFILE APIs (/api/v1/patients)
# ------------------------------------------------------------------------------
# POST /api/v1/patients                 - Create / register a new patient profile
# GET  /api/v1/patients                 - Search / list patients (by phone, name, ID)
# GET  /api/v1/patients/:id             - Get specific patient profile details
# POST /api/v1/patients/:id/identities  - Attach identity reference (ABHA / Aadhaar Demo)

API_PATIENT_CREATE=/api/v1/patients
API_PATIENT_SEARCH=/api/v1/patients
API_PATIENT_GET_BY_ID=/api/v1/patients/:id
API_PATIENT_IDENTITY_ATTACH=/api/v1/patients/:id/identities

# ------------------------------------------------------------------------------
# 3. CONSENT MANAGEMENT APIs (/api/v1/consents)
# ------------------------------------------------------------------------------
# POST /api/v1/consents                 - Grant patient consent (AI_CASE_TAKING, DOCUMENT_PROCESSING)
# GET  /api/v1/consents/:patientId      - Get patient active consents

API_CONSENT_GRANT=/api/v1/consents
API_CONSENT_GET_BY_PATIENT=/api/v1/consents/:patientId

# ------------------------------------------------------------------------------
# 4. CLINICAL SESSION APIs (/api/v1/sessions)
# ------------------------------------------------------------------------------
# POST /api/v1/sessions                 - Initialize a new clinical kiosk session (STARTED)
# GET  /api/v1/sessions/:id             - Retrieve clinical session status & details
# PUT  /api/v1/sessions/:id/status      - Update session status (IN_PROGRESS, COMPLETED, REVIEWED)
# GET  /api/v1/sessions/active          - List all active/pending kiosk sessions

API_SESSION_INIT=/api/v1/sessions
API_SESSION_GET_BY_ID=/api/v1/sessions/:id
API_SESSION_UPDATE_STATUS=/api/v1/sessions/:id/status
API_SESSION_LIST_ACTIVE=/api/v1/sessions/active

# ------------------------------------------------------------------------------
# 5. AI CASE TAKING & DIALOGUE APIs (/api/v1/case-messages)
# ------------------------------------------------------------------------------
# POST /api/v1/case-messages            - Post dialogue turn (PATIENT/AI/DOCTOR voice or text)
# GET  /api/v1/case-messages/:sessionId - Retrieve full dialogue turn history for session

API_CASE_MESSAGES_POST=/api/v1/case-messages
API_CASE_MESSAGES_GET_BY_SESSION=/api/v1/case-messages/:sessionId

# ------------------------------------------------------------------------------
# 6. CLINICAL OBSERVATIONS APIs (/api/v1/observations)
# ------------------------------------------------------------------------------
# POST /api/v1/observations             - Store AI-extracted symptom/medication observation
# GET  /api/v1/observations/:sessionId - Retrieve extracted structured observations

API_OBSERVATIONS_CREATE=/api/v1/observations
API_OBSERVATIONS_GET_BY_SESSION=/api/v1/observations/:sessionId

# ------------------------------------------------------------------------------
# 7. MEDICAL DOCUMENTS & OCR APIs (/api/v1/documents)
# ------------------------------------------------------------------------------
# POST /api/v1/documents/upload         - Upload prescription / lab report (Multer multipart)
# GET  /api/v1/documents/:sessionId     - Retrieve documents attached to a session
# POST /api/v1/documents/:id/ocr        - Trigger OCR text extraction on uploaded document

API_DOCUMENTS_UPLOAD=/api/v1/documents/upload
API_DOCUMENTS_GET_BY_SESSION=/api/v1/documents/:sessionId
API_DOCUMENTS_TRIGGER_OCR=/api/v1/documents/:id/ocr

# ------------------------------------------------------------------------------
# 8. CLINICAL RECORDS & DOCTOR REVIEW APIs (/api/v1/records)
# ------------------------------------------------------------------------------
# POST /api/v1/records/generate        - Synthesize draft SOAP record from AI observations
# GET  /api/v1/records/:id              - Get clinical record details
# PUT  /api/v1/records/:id/review       - Doctor review action (APPROVE, REJECT, EDIT)
# GET  /api/v1/records/patient/:patientId - List all historical approved clinical records

API_RECORDS_GENERATE=/api/v1/records/generate
API_RECORDS_GET_BY_ID=/api/v1/records/:id
API_RECORDS_REVIEW=/api/v1/records/:id/review
API_RECORDS_GET_PATIENT_HISTORY=/api/v1/records/patient/:patientId
